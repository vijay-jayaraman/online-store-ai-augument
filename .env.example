# Copy to .env and fill in local values. Never commit real .env files (SEC-06).
# Each app also has its own .env.example; later issues add their variables here and there.

NODE_ENV=development

# Local ports and URLs (see docs/MILESTONES.md §1.4)
API_PORT=4000
STORE_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
API_URL=http://localhost:4000

# API (apps/api reads apps/api/.env; see apps/api/.env.example)
MONGODB_URI=mongodb://localhost:27017/bookstore
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
LOG_LEVEL=info

# Store app (apps/store reads apps/store/.env; see apps/store/.env.example)
VITE_API_URL=http://localhost:4000/api/v1
