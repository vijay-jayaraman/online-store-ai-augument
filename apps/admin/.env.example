# Copy to apps/admin/.env to override the defaults. Never commit real .env files (SEC-06).
# Only variables prefixed with VITE_ reach the browser bundle, so never put secrets here.

# Base URL of the REST API, including the /api/v1 prefix
VITE_API_URL=http://localhost:4000/api/v1

# Buyer storefront URL, used by the "View store" link
VITE_STORE_URL=http://localhost:5173
