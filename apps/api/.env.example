# Copy to apps/api/.env and fill in local values. Never commit real .env files (SEC-06).
# Variables already set in the environment override this file.

NODE_ENV=development
API_PORT=4000

# MongoDB 8 and Redis (local Docker containers or hosted services)
MONGODB_URI=mongodb://localhost:27017/bookstore
REDIS_URL=redis://localhost:6379

# Comma-separated browser origins allowed by CORS (store and admin apps)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
