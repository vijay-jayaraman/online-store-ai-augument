# Copy to e2e/.env to override the defaults. Never commit real .env files (SEC-06).
# With localhost URLs, `npm run test:e2e` starts the store and admin dev servers and the API itself.
# The API needs MongoDB and Redis running locally (see CLAUDE.md) and uses the `bookstore-e2e`
# database. Point these at staging (for example https://store.staging.<domain>) to test it instead;
# Playwright then starts nothing locally.

STORE_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
API_URL=http://localhost:4000

# Optional: MongoDB and Redis for the locally started API.
# E2E_MONGODB_URI=mongodb://localhost:27017/bookstore-e2e
# E2E_REDIS_URL=redis://localhost:6379
