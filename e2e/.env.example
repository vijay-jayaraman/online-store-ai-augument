# Copy to e2e/.env to override the defaults. Never commit real .env files (SEC-06).
# With localhost URLs, `npm run test:e2e` starts the store and admin dev servers itself.
# Point these at staging (for example https://store.staging.<domain>) to test it instead;
# Playwright then starts nothing locally.

STORE_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
API_URL=http://localhost:4000
